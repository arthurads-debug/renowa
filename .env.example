# Copie para as Environment Variables do projeto na Vercel (Settings → Environment Variables).
# Nunca suba valores reais para o repositório.

# --- Sessão ---
# Texto aleatório com 32+ caracteres. Gere com: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Equipe da agência (acesso ao /admin) ---
# Gere o hash com: python3 tools/criar_senha.py
ADMIN_EMAIL=voce@suaagencia.com.br
ADMIN_PASSWORD_HASH=
# Vários usuários: ADMINS_JSON=[{"email":"a@agencia.com","passwordHash":"pbkdf2_sha256$..."},{"email":"b@agencia.com","passwordHash":"..."}]

# --- Banco de dados dos clientes (criado pela Vercel: Storage → Upstash for Redis) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- WhatsApp da agência (só números, com DDI) ---
# Usado no botão "Falar com a agência" e na aprovação de posts do calendário
AGENCY_WHATSAPP=5511900000000

# --- CRM de leads ---
# Opcional: URL (Make, Zapier, n8n, Slack, Discord) que recebe cada aplicação nova do site, para avisar a equipe.
LEAD_NOTIFY_WEBHOOK=

# --- Clientes ---
# O jeito recomendado é cadastrar pelo painel /admin (fica salvo no banco acima).
# Opcional: clientes fixos em JSON (mesmo formato; o painel tem prioridade se o id se repetir).
# profile: "awareness" (divulgação/institucional) · "leads" (WhatsApp + loja física) · "sales" (venda online)
# CLIENTS_JSON=[{"id":"casabella","name":"Casa Bella Móveis","contactName":"Rafael","email":"rafael@casabella.com.br","passwordHash":"pbkdf2_sha256$210000$...$...","profile":"leads","resultLabel":"Conversas no WhatsApp","googleAds":{"customerId":"123-456-7890"},"metaAds":{"adAccountId":"act_1234567890","resultActionTypes":["onsite_conversion.messaging_conversation_started_7d"]},"instagram":{"userId":"17841400000000000"},"sheets":{"calendar":"https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv","sales":"https://docs.google.com/spreadsheets/d/e/.../pub?gid=1&single=true&output=csv","reports":"https://docs.google.com/spreadsheets/d/e/.../pub?gid=2&single=true&output=csv"},"salesFormUrl":"https://forms.gle/...","note":"Recado da agência no topo do painel."}]

# --- Google Ads API ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# ID da conta administradora (MCC) da agência, só números
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Confira a versão vigente em https://developers.google.com/google-ads/api/docs/release-notes
GOOGLE_ADS_API_VERSION=v21

# --- Meta (anúncios + Instagram orgânico) ---
# Token de Usuário do Sistema (Business Manager) com: ads_read, pages_show_list, pages_read_engagement, read_insights,
# instagram_basic, instagram_manage_insights. Atribua ao usuário as contas de anúncio, páginas e Instagrams dos clientes.
META_ACCESS_TOKEN=
# Opcional, recomendado: ativa appsecret_proof
META_APP_SECRET=
META_API_VERSION=v21.0

# --- Cache ---
# Segundos que um resultado das APIs de anúncios fica em cache (padrão 300 = 5 min)
CACHE_TTL_SECONDS=300
